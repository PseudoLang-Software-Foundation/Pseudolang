import "../common.just"
import "./build.just"
import "./test.just"
import "./run.just"
import "./vscode.just"

# Default recipe
default:
  just --list

# Display current version from Cargo.toml
version:
  @echo "{{VERSION}}"

# Tag current version and push to trigger a release
tag-release:
  #!/usr/bin/env bash
  set -euo pipefail
  cd "{{ROOT}}"
  TAG="v{{VERSION}}"
  if git rev-parse "${TAG}" >/dev/null 2>&1; then
    echo "Tag ${TAG} already exists"
    exit 1
  fi
  git tag -a "${TAG}" -m "Release ${TAG}"
  git push origin "${TAG}"
  echo "Pushed ${TAG} -- CI will build and publish the release"

# Install all dev dependencies and build toolchain
install:
  cargo install cross taplo-cli cargo-deb
  rustup target add wasm32-unknown-unknown wasm32-wasip1
  curl https://rustwasm.github.io/wasm-pack/installer/init.sh -sSf | sh
  cd {{ROOT}}/extensions/vscode && bun install

# Amend no edit
amend:
  git commit --amend --no-edit

# Force push
fp:
  git push -f --force-with-lease

# Amend and force push
afp:
  git commit --amend --no-edit && git push -f --force-with-lease

# Add, amend and force push
aafp:
  git add . && git commit --amend --no-edit && git push -f --force-with-lease
